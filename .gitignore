/target
# Extra cargo target dirs used by per-PR worktrees (target-wt1587, ...);
# build output must never be committed.
/target-*/
.DS_Store
CLAUDE.md
openspec/
research/
.augment/
.claude/*
!.claude/skills/
.serena/
.worktrees/
.idea/

# M3.4.1 — local-only PDFium dynamic library drop (per-host, large
# binary). Tests look for it via PDFIUM_DYNAMIC_LIB_PATH or
# `<repo>/.pdfium-bin/lib/`. Download from
# https://github.com/bblanchon/pdfium-binaries/releases for your arch.
/.pdfium-bin/
.opencode/
.superpowers/
mur-hub-gui/src-tauri/resources/models/default/
eval-out/
.tokensave/

# Skill-authoring scratch dir (docs/superpowers/plans/2026-07-04-role-skill-packs.md)
registry-work/

# `mur sync` rewrites its generated block into any of these that EXIST on disk
# (mur-core/src/inject/sync.rs, gated on `target_path.exists()`), so a tracked
# copy turns every sync into a dirty working tree. CLAUDE.md is the one
# hand-authored source; keep local tool files local.
AGENTS.md
.cursorrules
.windsurfrules
/.cargo-target-*/

# Scratch cargo target dirs that fleet/agent runs create beside the repo
# root (e.g. .target-fleet-run-handle-ledger/ — a full 15M build tree).
# Same reason as /.cargo-target-*/ above: never a tracked artifact.
/.target-*/

# Playwright MCP snapshots/console logs written into the cwd
.playwright-mcp/

# Internal design history (specs, plans, validation runs, competitive notes)
# lives in the private mur-run/mur-docs repository. Keep a clone of it at
# docs/superpowers/ so tooling that writes plans/specs there keeps working;
# none of it is part of the public source tree.
/docs/superpowers/
/docs/plans/
/docs/mur-函數清單與競品分析.md

# Editor / agent backup and merge leftovers (e.g. a `keys.rs.bak` written
# before an in-place rewrite). A bare `git add -A` would otherwise commit
# them; nothing in this tree is meant to be tracked under these suffixes.
*.bak
*.orig
*.rej
