{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MurAgent",
  "version": "2.4.1",
  "identifier": "run.mur.agent.template",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Agent Settings",
        "width": 720,
        "height": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "logs",
        "title": "Agent Logs",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["muragent-{{AGENT_SLUG}}"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": [
      "binaries/mur-agent-runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "themes/**/*",
      "Resources/PrivacyInfo.xcprivacy"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "frameworks": []
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
