<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WebKit JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- node / python MCP children that JIT or use unsigned executable memory -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- MCP binaries are user-installed (brew/npm/uv); not signed by the same identity -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- V8 / Node executable page protection conflict -->
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
    <!-- MUR_* env vars used by the runtime + agent payload -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- A2A peer connections (outbound) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Inbound TCP+Noise listener -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- User-selected file picks (skill / icon / log export) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
